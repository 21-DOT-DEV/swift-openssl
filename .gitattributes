# Auto-detect text files and normalize line endings
* text=auto

# Swift files
*.swift text diff=swift

# C files (upstream library code)
*.c text diff=c
*.h text diff=c

# Upstream C library in Sources should be marked as vendored
Sources/libcrypto/**    linguist-vendored
Sources/libssl/**       linguist-vendored

# Custom placeholder files (not vendored)
Sources/libcrypto/src/Placeholder.c         linguist-vendored=false
Sources/libcrypto/include/Placeholder.h     linguist-vendored=false
Sources/libssl/src/Placeholder.c            linguist-vendored=false
Sources/libssl/include/Placeholder.h        linguist-vendored=false

# Configure-generated headers (not in upstream; produced by ./Configure + make build_all_generated)
Sources/libcrypto/include/openssl/configuration.h               linguist-generated
Sources/libcrypto/internal_include/crypto/buildinf.h            linguist-generated
Sources/libcrypto/providers/providers/fips/include/fips/fipsindicator.h linguist-generated

# Vendor/development directories
Vendor/**                   export-ignore linguist-vendored
.build/**                   export-ignore linguist-vendored
.build_custom/**            export-ignore linguist-vendored
.github/**                  export-ignore linguist-vendored
.vscode/**                  export-ignore linguist-vendored
.swiftpm/**                 export-ignore linguist-vendored
.specify/**                 export-ignore linguist-vendored
.windsurf/**                export-ignore linguist-vendored
specs/**                    export-ignore linguist-vendored

# CI/CD and tooling configs
Dockerfile                  export-ignore
.dockerignore               export-ignore
subtree.yaml                export-ignore

# Development documentation
libcrypto-build-mapping.md  export-ignore

# Git and editor files
.gitignore                  export-ignore
.DS_Store                   export-ignore

# Package lockfile (not needed for library consumers)
Package.resolved            export-ignore linguist-generated
